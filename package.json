{"name":"magia-glass-viremarca","version":"1.0.0","private":true,"scripts":{"dev":"next dev","inject-nav":"find public -type f -name '*.html' ! -path 'public/admin/*' -exec sed -i 's#</body>#<script src=\"/assets/js/navigation.js\"></script></body>#' {} +","build":"rm -rf public && mkdir -p public && cp -R assets admin pages index.html public/ && npm run inject-nav && next build","start":"next start"},"dependencies":{"@libsql/client":"^0.15.9","bcryptjs":"^3.0.2","next":"^15.5.0","react":"^19.1.0","react-dom":"^19.1.0"},"devDependencies":{"@types/node":"^22.0.0","@types/react":"^19.0.0","@types/react-dom":"^19.0.0","eslint":"^9.0.0","typescript":"^5.0.0"}}